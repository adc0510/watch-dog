<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PC Watchdog</vendor>
  <action id="io.github.pcwatchdog.helper">
    <description>Change PC Watchdog system settings</description>
    <message>PC Watchdog needs your password to change system protection settings</message>
    <icon_name>io.github.pcwatchdog</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/pc-watchdog/pcw-helper</annotate>
  </action>
</policyconfig>
