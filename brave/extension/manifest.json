{
  "manifest_version": 3,
  "name": "PC Watchdog Tabs",
  "version": "1.0",
  "description": "Lets the PC Watchdog desktop app list your tabs, show their RAM/CPU and sleep or close them.",
  "key": "",
  "background": { "service_worker": "bg.js" },
  "permissions": ["tabs", "scripting", "nativeMessaging", "favicon"],
  "host_permissions": ["<all_urls>"],
  "icons": { "128": "icon128.png", "48": "icon48.png" }
}
